{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host-debug",
            "displayName": "Host Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/host-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "BUILD_STM32F103": "OFF"
            }
        },
        {
            "name": "stm32f103-debug",
            "displayName": "STM32F103 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32f103-debug",
            "toolchainFile": "${sourceDir}/tools/cmake/toolchains/arm-none-eabi-gcc.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "OFF",
                "BUILD_STM32F103": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-debug",
            "configurePreset": "host-debug"
        },
        {
            "name": "stm32f103-debug",
            "configurePreset": "stm32f103-debug"
        }
    ]
}